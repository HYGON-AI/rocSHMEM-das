set(_run_stub "@CMAKE_BINARY_DIR@/rocshmem.run.stub")
if(NOT EXISTS "${_run_stub}")
  message(FATAL_ERROR "Installer stub was not generated: ${_run_stub}")
endif()

foreach(_package IN LISTS CPACK_PACKAGE_FILES)
  if(NOT _package MATCHES "\\.tar\\.gz$")
    continue()
  endif()

  get_filename_component(_package_name "${_package}" NAME)
  string(REGEX REPLACE "\\.tar\\.gz$" ".run" _run_name "${_package_name}")
  set(_run "${CPACK_PACKAGE_DIRECTORY}/${_run_name}")
  set(_run_tmp "${_run}.tmp")
  file(REMOVE "${_run_tmp}")
  execute_process(
    COMMAND "@CMAKE_COMMAND@" -E cat "${_run_stub}" "${_package}"
    OUTPUT_FILE "${_run_tmp}"
    RESULT_VARIABLE _cat_result
  )
  if(NOT _cat_result EQUAL 0)
    file(REMOVE "${_run_tmp}")
    message(FATAL_ERROR "Failed to create ${_run}")
  endif()

  file(CHMOD "${_run_tmp}"
    PERMISSIONS
      OWNER_READ OWNER_WRITE OWNER_EXECUTE
      GROUP_READ GROUP_EXECUTE
      WORLD_READ WORLD_EXECUTE
  )
  file(RENAME "${_run_tmp}" "${_run}")
  message(STATUS "Created self-extracting installer: ${_run}")
endforeach()
